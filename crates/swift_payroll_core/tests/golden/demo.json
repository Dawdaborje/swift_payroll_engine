        "id": "housing",
        "label": "Housing (20% of base)",
        "kind": "earning",
        "formula": "pct(base, 20)"
      },
      {
        "id": "gross",
        "label": "Gross",
        "kind": "info",
        "formula": "total(\"earning\")"
      },
      {
        "id": "social",
        "label": "Social security (5% of pensionable pay)",
        "kind": "deduction",
        "tags": [
          "pre_tax"
        ],
        "formula": "pct(total(\"pensionable\"), 5)"
      },
      {
        "id": "taxable",
        "label": "Taxable pay",
        "kind": "info",
        "formula": "gross - total(\"pre_tax\")"
      },
      {
        "id": "paye",
        "label": "Income tax",
        "kind": "deduction",
        "formula": "bracket(taxable * periods_per_year, paye_table) / periods_per_year"
      },
      {
        "id": "loan",
        "label": "Loan repayment",
        "kind": "deduction",
        "input": "loan_amount",
        "when": "loan_amount > 0"
      },
      {
        "id": "employer_social",
        "label": "Employer social security (10%)",
        "kind": "employer",
        "formula": "pct(total(\"pensionable\"), 10)"
      }
    ]
